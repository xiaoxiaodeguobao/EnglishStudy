# =============================================================================
# Vocabulary Learning App - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual API keys
# Never commit the .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# AI Service Configuration (Required for word generation and example sentences)
# -----------------------------------------------------------------------------
# Choose ONE of the following AI providers:

# Option 1: OpenAI API
# Get your API key from: https://platform.openai.com/api-keys
# Pricing: https://openai.com/pricing
VITE_OPENAI_API_KEY=sk-your-openai-api-key-here
VITE_OPENAI_MODEL=gpt-3.5-turbo
VITE_OPENAI_API_URL=https://api.openai.com/v1

# Option 2: Anthropic Claude API
# Get your API key from: https://console.anthropic.com/
# Pricing: https://www.anthropic.com/pricing
VITE_CLAUDE_API_KEY=sk-ant-your-claude-api-key-here
VITE_CLAUDE_MODEL=claude-3-haiku-20240307
VITE_CLAUDE_API_URL=https://api.anthropic.com/v1

# Option 3: 字节跳动豆包 (Doubao) API - 中国大陆可用
# 获取 API Key: https://console.volcengine.com/ark
# 文档: https://www.volcengine.com/docs/82379
# 定价: https://www.volcengine.com/docs/82379/1099320
VITE_DOUBAO_API_KEY=your-doubao-api-key-here
VITE_DOUBAO_MODEL=doubao-pro-4k
VITE_DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3

# Option 4: DeepSeek API - 中国大陆可用，性价比高
# 获取 API Key: https://platform.deepseek.com/api_keys
# 文档: https://platform.deepseek.com/api-docs/
# 定价: https://platform.deepseek.com/api-docs/pricing/
VITE_DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
VITE_DEEPSEEK_MODEL=deepseek-chat
VITE_DEEPSEEK_API_URL=https://api.deepseek.com

# AI Provider Selection (openai, claude, doubao, or deepseek)
VITE_AI_PROVIDER=openai

# Generic AI Configuration (Optional - overrides provider-specific settings)
# Use these to override the model or API URL for the selected provider
# VITE_AI_MODEL=gpt-4
# VITE_AI_API_URL=https://custom-api-endpoint.com/v1

# -----------------------------------------------------------------------------
# Dictionary API Configuration (No API key required)
# -----------------------------------------------------------------------------
# Free Dictionary API - No authentication needed
# Documentation: https://dictionaryapi.dev/
VITE_DICTIONARY_API_URL=https://api.dictionaryapi.dev/api/v2

# -----------------------------------------------------------------------------
# Application Configuration (Optional)
# -----------------------------------------------------------------------------
# Maximum retry attempts for API requests
VITE_MAX_API_RETRIES=3

# API request timeout in milliseconds
VITE_API_TIMEOUT=30000

# Enable debug logging (true/false)
VITE_DEBUG_MODE=false
